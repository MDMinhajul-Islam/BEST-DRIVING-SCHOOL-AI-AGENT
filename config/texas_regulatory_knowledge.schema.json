{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Texas regulatory knowledge v1",
  "type": "object",
  "required": ["schema_version", "research_date", "jurisdiction", "categories", "rules", "terminology", "unresolved_questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "research_date": {"type": "string", "format": "date"},
    "jurisdiction": {"const": "Texas"},
    "categories": {"type": "array", "uniqueItems": true, "minItems": 12, "items": {"type": "string"}},
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "category", "title", "conditions", "requirements", "confidence", "official_sources", "evidence", "last_verified", "source_last_updated", "review_required", "safe_for_general_guidance"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^TX-R[0-9]{3}$"},
          "category": {"enum": ["adult_first_time", "teen", "learner_license", "parent_taught", "driver_education", "road_test", "impact_texas_drivers", "new_texas_resident", "international_driver", "documents", "third_party_testing", "exceptions"]},
          "title": {"type": "string", "minLength": 1},
          "conditions": {"type": "object", "minProperties": 1},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"enum": ["official_verified", "official_but_date_uncertain", "conflicting_official_sources", "business_only", "requires_human_review", "requires_dps_confirmation"]},
          "official_sources": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string"}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "url", "section_locator", "extracted_path", "normalized_content_hash"], "properties": {"source_id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "section_locator": {"type": "string", "minLength": 1}, "normalized_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
          "last_verified": {"type": "string", "format": "date"},
          "source_last_updated": {"type": "object"},
          "review_required": {"type": "boolean"},
          "safe_for_general_guidance": {"type": "boolean"}
        }
      }
    }
  }
}
