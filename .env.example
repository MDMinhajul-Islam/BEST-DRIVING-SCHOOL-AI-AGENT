BOOKING_PROVIDER=calcom
BOOKING_MODE=mock
BOOKING_DB_PATH=/app/runtime/booking.sqlite3
RETELL_TOOL_SECRET=
CALCOM_API_KEY=
CALCOM_API_BASE_URL=https://api.cal.com
# API headers are pinned per endpoint in calcom_adapter.py; no universal version override.
# slots=2024-09-04; bookings=2026-02-25; event types=2024-06-14
CALCOM_TIMEZONE=America/Chicago
CALCOM_EVENT_TYPE_DRIVING_120=
CALCOM_EVENT_TYPE_DRIVING_60=
CALCOM_EVENT_TYPE_ROAD_TEST_30=
CALCOM_WRITE_ENABLED=false
CALCOM_LIVE_ENABLED=false
CALCOM_TEST_EMAIL=

# Optional isolated website voice broker (src.routes.voice:create_app)
RETELL_API_KEY=
RETELL_AGENT_ID=
# At least 32 random characters; same server-only value in frontend/.env.local
VOICE_PROXY_SECRET=
